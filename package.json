{
  "name": "akuntansi-practice",
  "private": true,
  "version": "1.0.1",
  "description": "DEKRi Lab: latihan siklus akuntansi PT Sumber Cahaya Elektrindo (aplikasi desktop portable)",
  "author": "Ridhwan",
  "license": "MIT",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "extract": "python3 -I tools/extract_workbook.py",
    "gen": "python3 -I tools/gen_statements.py",
    "build:single": "tsc --noEmit && vite build -c vite.singlefile.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node e2e/run.cjs",
    "check": "tsc --noEmit && vitest run && prettier --check .",
    "desktop": "electron .",
    "dist:win": "npm run build:single && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.ridhwan.latihansiklusakuntansi",
    "productName": "DEKRi Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/backup.cjs",
      "desktop/dekri-lab.ico",
      "dist-single/index.html",
      "package.json",
      "!node_modules"
    ],
    "asar": true,
    "artifactName": "DEKRi-Lab-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DEKRi Lab",
      "uninstallDisplayName": "DEKRi Lab",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "licenses/LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "src/assets/fonts/OFL.txt",
        "to": "licenses/OFL-Inter.txt"
      }
    ]
  }
}
